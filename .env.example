SARVAM_API_KEY=

# --- MVP language: English -----------------------------------------------
# Flip to Marathi later with:
#   BANKU_LANG=mr
#   BANKU_STT_LANGUAGE=mr-IN
#   BANKU_STT_MODE=codemix
#   BANKU_TTS_LANG=mr
BANKU_LANG=en
BANKU_TTS_LANG=en
BANKU_TTS_REGION=IN
BANKU_TTS_RATE=1.0
BANKU_TTS_ENGINE=com.google.android.tts

# --- Speech to text -------------------------------------------------------
BANKU_STT_PROVIDER=sarvam
BANKU_STT_MODEL=saaras:v4
BANKU_STT_LANGUAGE=en-IN
BANKU_STT_MODE=transcribe
BANKU_LLM_PROVIDER=groq
BANKU_LLM_MODEL=openai/gpt-oss-20b
BANKU_LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
